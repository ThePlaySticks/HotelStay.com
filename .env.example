# ===================================================================
# HOTELSTAY — ENVIRONMENT CONFIGURATION
# ===================================================================

# Supabase Public Configuration (Required for Supabase Auth)
# Obtain these from your Supabase Project Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Auth URL Configuration (Configure in Supabase Dashboard -> Authentication -> URL Configuration):
# Site URL:
#   https://hotel-stay-com.vercel.app/
#
# Redirect URLs (Authentication callbacks & password reset):
#   https://hotel-stay-com.vercel.app/auth/callback
#   https://hotel-stay-com.vercel.app/auth/reset-password

# NextAuth Configuration
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional Email Providers & Routing
# Primary Provider: Resend (https://resend.com)
PRIMARY_EMAIL_PROVIDER=resend
PRIMARY_EMAIL=HotelStay Security <onboarding@resend.dev>
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=HotelStay Security <onboarding@resend.dev>

# Fallback Provider: Brevo (https://brevo.com)
FALLBACK_EMAIL_PROVIDER=brevo
FALLBACK_EMAIL=auth@hotelstay.com
FALLBACK_EMAIL_NAME=HotelStay Security
BREVO_API_KEY=xkeysib_your_brevo_api_key_here
BREVO_SENDER_EMAIL=auth@hotelstay.com
BREVO_SENDER_NAME=HotelStay Security
ADMIN_INITIAL_EMAIL=admin@hotelstay.com
ADMIN_INITIAL_PASSWORD=HotelStaySuperAdmin12321
